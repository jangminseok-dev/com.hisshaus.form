# 신청이 들어오면 알림을 보낼 슬랙 수신 웹훅 주소
SLACK_WEBHOOK_URL=
# (선택) 알림 첫 줄에 붙일 멘션: channel · here · 슬랙 멤버 ID(U…). 쉼표로 여러 개. 없으면 멘션 없이 보낸다.
SLACK_MENTION=
# 구글 서비스 계정 키(JSON)를 base64 로 인코딩한 값
GOOGLE_SERVICE_ACCOUNT_JSON=
# 신청을 쌓을 구글 시트 ID
GOOGLE_SHEET_ID=
# 검사지 링크의 서명 비밀값(32자 이상). openssl rand -base64 32 로 만든다. 운영과 같은 값이어야 pnpm survey:link 링크가 열린다.
SURVEY_LINK_SECRET=

# (테스트용) 아래 둘은 e2e(pnpm e2e)가 진짜 시트 대신 가짜 서비스를 부를 때만 쓴다. 운영에는 두지 않는다.
# NODE_ENV=production 이면 있어도 읽지 않는다.
# 구글 시트 API 주소의 앞부분(끝에 / 없이). 없으면 구글 주소.
# SHEETS_BASE_URL=
# 서비스 계정 JWT 대신 쓸 고정 토큰
# SHEETS_FAKE_TOKEN=
